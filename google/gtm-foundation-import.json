    "variable": [
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Allowed",
        "type": "jsm",
        "variableId": "100",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n try { var u=new URL({{Page URL}}), p=u.pathname.replace(/^\\/(fa|en|ar)(?=\\/|$)/,'')||'/';\n return u.protocol==='https:' && /^(www\\.)?foodexecosystem\\.com$/.test(u.hostname) && !u.port && !u.username && !u.password && !/^\\/(admin|api|auth|login|_next)(?:\\/|$)/.test(p);\n } catch(e){return false;}\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Content language",
        "type": "jsm",
        "variableId": "101",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n var m=/^\\/(fa|en|ar)(?:\\/|$)/.exec({{Page Path}}||'');\n if(m)return m[1];\n var lang=(document.documentElement.lang||'').toLowerCase().split('-')[0];\n return /^(en|fa|ar)$/.test(lang)?lang:'other';\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Content group",
        "type": "jsm",
        "variableId": "102",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n var p=({{Page Path}}||'/').replace(/^\\/(fa|en|ar)(?=\\/|$)/,'')||'/';\n if(/^\\/(admin|api|auth|login|_next)(?:\\/|$)/.test(p))return 'admin';\n if(/^\\/(policies|privacy|terms|confidentiality)\\/?$/.test(p))return 'policies';\n if(/^\\/(about-us|contact-us|faq)?\\/?$/.test(p))return 'corporate';\n return 'other';\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Page type",
        "type": "jsm",
        "variableId": "103",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n var p=({{Page Path}}||'/').replace(/^\\/(fa|en|ar)(?=\\/|$)/,'')||'/';\n if(/^\\/(admin|api|auth|login|_next)(?:\\/|$)/.test(p))return 'admin';\n if(p==='/')return 'home';\n var m=/^\\/(about-us|contact-us|faq|policies|privacy|terms|confidentiality)\\/?$/.exec(p);\n if(!m)return 'other';\n return m[1]==='about-us'?'about':m[1]==='contact-us'?'contact':/^(privacy|terms|confidentiality|policies)$/.test(m[1])?'policy':m[1];\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Traffic | Staff marker",
        "type": "jsm",
        "variableId": "104",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {return /(?:^|;\\s*)fxe_staff=1(?:;|$)/.test(document.cookie||'')?'internal':undefined;}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Link | Contact method",
        "type": "jsm",
        "variableId": "105",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n var raw={{Click URL}}||'';\n if(/^tel:/i.test(raw))return 'phone';\n if(/^mailto:/i.test(raw))return 'email';\n try{var u=new URL(raw,{{Page URL}});\n if(u.protocol==='https:'&&!u.port&&!u.username&&!u.password&&/^(wa\\.me|api\\.whatsapp\\.com|web\\.whatsapp\\.com)$/.test(u.hostname))return 'whatsapp';\n }catch(e){}return undefined;\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Link | Destination group",
        "type": "jsm",
        "variableId": "106",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n try{var u=new URL({{Click URL}}||'',{{Page URL}});\n if(u.protocol!=='https:'||u.port||u.username||u.password)return undefined;\n if(/^(www\\.)?foodexiran\\.com$/.test(u.hostname))return /^\\/(?:en\\/|fa\\/)?services(?:\\/|$)/.test(u.pathname)?'consultant':'iran';\n if(/^(www\\.)?(foodexdigital\\.com|foodex\\.digital)$/.test(u.hostname))return 'digital';\n if(/^(www\\.)?foodextrade\\.com$/.test(u.hostname))return 'trade';\n }catch(e){}return undefined;\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Link | Position",
        "type": "jsm",
        "variableId": "107",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n var el={{Click Element}};\n if(!el||!el.closest)return 'other';\n if(el.closest('footer'))return 'footer';\n if(el.closest('header'))return 'header';\n if(el.closest('main'))return 'main';\n return 'other';\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Message valid",
        "type": "jsm",
        "variableId": "108",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n if(!{{FXE | Page | Allowed}})return false;\n try{var supplied=new URL({{FXE | DLV | Page location}}), current=new URL({{Page URL}}), title={{FXE | DLV | Page title}}, ref={{FXE | DLV | Page referrer}};\n return supplied.href.split('#')[0]===current.href.split('#')[0]&&typeof title==='string'&&title.length>0&&title.length<=300&&title===document.title&&typeof ref==='string'&&ref.length<=2048;\n }catch(e){return false;}\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Safe location",
        "type": "jsm",
        "variableId": "109",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n var raw={{Event}}==='fx_page_ready'?{{FXE | DLV | Page location}}:{{Page URL}};\n try{var u=new URL(raw);\n if(u.protocol!=='https:'||!/^(www\\.)?foodexecosystem\\.com$/.test(u.hostname)||u.port||u.username||u.password)return undefined;\n var safe=new URL(u.origin+u.pathname), keys=['utm_source','utm_medium','utm_campaign','utm_id','utm_content','utm_term'];\n keys.forEach(function(key) {\n var v=u.searchParams.get(key);\n if(v && v.length <= 120 && /^[A-Za-z0-9._~-]+$/.test(v) && !/[0-9][0-9][0-9][0-9][0-9][0-9][0-9]/.test(v)) safe.searchParams.set(key,v);\n });\n var service=u.searchParams.get('service');\n if(service==='foodex-consultant'||service==='foodex-digital'||service==='foodex-trade')safe.searchParams.set('service',service);\n return safe.href;\n }catch(e){return undefined;}\n}"
          }
        ]
      },
      {
        "accountId": "6402453283",
        "containerId": "285168513",
        "name": "FXE | Page | Safe referrer",
        "type": "jsm",
        "variableId": "110",
